# Docker Compose 配置。复制为 .env 后必须填写所有必填项（.env 已被 .gitignore 忽略）
#   copy .env.example .env        # Windows
#   cp .env.example .env          # macOS / Linux
#
# 生成密钥：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development
LOG_LEVEL=INFO

# 必填：至少 32 个字符，生产环境不能使用示例值
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 必填：数据库密码。
# 新建数据卷时请使用强密码；如果沿用已有开发数据卷，必须填写该卷初始化时的密码。
POSTGRES_DB=notifyhub
POSTGRES_USER=notifyhub
POSTGRES_PASSWORD=

# 必填：Redis 密码，建议使用 URL 安全字符（token_urlsafe 生成即可）
REDIS_PASSWORD=

# 宿主机访问端口（默认只绑定 127.0.0.1；被占用时可修改）
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Docker Nginx 是可信反向代理，覆盖 X-Forwarded-For
TRUST_PROXY_HEADERS=true

# 登录限流：IP / 邮箱两个维度
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_IP_WINDOW=60
LOGIN_RATE_LIMIT_EMAIL_MAX=5
LOGIN_RATE_LIMIT_EMAIL_WINDOW=300

# 仅演示环境使用：通知内容包含 [FAIL] 时模拟失败
ALLOW_FAILURE_SIMULATION=false
MAX_NOTIFICATION_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=5
PROCESSING_TIMEOUT_SECONDS=300
DISPATCH_STALE_SECONDS=120
# 必须满足 soft < hard < PROCESSING_TIMEOUT_SECONDS
NOTIFICATION_SOFT_TIME_LIMIT_SECONDS=240
NOTIFICATION_TIME_LIMIT_SECONDS=280
EXTERNAL_DELIVERY_TIMEOUT_SECONDS=10
