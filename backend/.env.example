# 本地开发配置。复制为 backend/.env 后填写（.env 已被 .gitignore 忽略）
# 生成密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development
LOG_LEVEL=INFO

# 必填：至少 32 个字符
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 必填：替换 CHANGE_ME 为本地 PostgreSQL 密码
DATABASE_URL=postgresql+psycopg://notifyhub:CHANGE_ME@127.0.0.1:5432/notifyhub
# 可选：留空时测试会自动派生 <数据库名>_test
TEST_DATABASE_URL=
DATABASE_ECHO=false

# 必填：替换 CHANGE_ME 为本地 Redis 密码
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Windows 本地直连后端，不信任代理头；Docker 中由 Compose 设为 true
TRUST_PROXY_HEADERS=false

# 登录限流：IP / 邮箱两个维度
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_IP_WINDOW=60
LOGIN_RATE_LIMIT_EMAIL_MAX=5
LOGIN_RATE_LIMIT_EMAIL_WINDOW=300

MAX_NOTIFICATION_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=5
PROCESSING_TIMEOUT_SECONDS=300
DISPATCH_STALE_SECONDS=120
# 必须满足 soft < hard < PROCESSING_TIMEOUT_SECONDS
NOTIFICATION_SOFT_TIME_LIMIT_SECONDS=240
NOTIFICATION_TIME_LIMIT_SECONDS=280
EXTERNAL_DELIVERY_TIMEOUT_SECONDS=10

# 仅本地演示/测试使用：通知内容包含 [FAIL] 时模拟失败
ALLOW_FAILURE_SIMULATION=false
